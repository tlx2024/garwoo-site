---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
import Icon from '../components/Icon.astro';
import { windowsCta } from '../data/status';
const cta = await windowsCta();
---
<Base title="手机伴侣" description="格物手机伴侣与微信小程序（规划中）：离开电脑也能看进展、确认写操作。" page="mobile">
<style is:global>
.phones{display:flex;justify-content:center;align-items:flex-end;gap:36px}
.phones .phone{border-bottom:0;border-bottom-left-radius:0;border-bottom-right-radius:0;height:380px}
.phones .phone.mid{height:440px}
@media (max-width:760px){.phones .phone:not(.mid){display:none}}
.relay{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:12px;text-align:center}
.relay .card{padding:28px 16px}
.relay .card .ic{margin:0 auto 12px}
.relay .wire{width:80px;height:1px;background:repeating-linear-gradient(90deg,var(--line-strong) 0 6px,transparent 6px 11px);position:relative}
@media (max-width:760px){.relay{grid-template-columns:1fr}.relay .wire{width:1px;height:32px;margin:0 auto;background:repeating-linear-gradient(180deg,var(--line-strong) 0 6px,transparent 6px 11px)}.relay .wire::after{display:none}}
</style>
<style>
  .decision .act { margin-top: 4px; }
  .preview-picker { display: none; }
  .upload-demo button { width: 100%; min-height: 44px; font: inherit; border: 0; background: var(--primary); color: white; border-radius: 6px; cursor: pointer; }
  .progress-demo summary { cursor: pointer; }
  .progress-demo details p { color: var(--muted); margin-top: 6px; }
  .phones .phone.progress-demo { height: auto; min-height: 380px; }
  @media (max-width: 760px) {
    .preview-picker:not([hidden]) { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 18px; }
    .preview-picker select { border: 1px solid var(--line-strong); border-radius: 6px; padding: 0 12px; height: 44px; color: var(--ink); background: var(--panel); font: inherit; }
    .phones[data-view] > .phone { display: none; }
    .phones[data-view="progress"] .progress-demo, .phones[data-view="decision"] .decision, .phones[data-view="upload"] .upload-demo { display: flex; }
  }
  .phones .phone.decision { height: auto; min-height: 440px; }
  .decision img { display: block; width: 92px; height: 92px; object-fit: contain; align-self: center; margin: 4px 0; }
  .decision .act[hidden] { display: none; }
  .decision .act button { min-height: 44px; border-radius: 6px; background: var(--panel); color: var(--ink); border: 1px solid var(--line-strong); font: inherit; cursor: pointer; }
  .decision .act button:last-child { background: var(--primary); color: white; border-color: transparent; }
  .decision .act button:only-child { grid-column: 1 / -1; }
  .decision summary { cursor: pointer; padding-block: 4px; color: var(--primary); }
  .decision details p { margin-block-start: 6px; color: var(--muted); }
  .decision .tile { line-height: 1.55; }
  .decision .tile[data-done] { border-color: var(--primary); }
  @media (prefers-reduced-motion: no-preference) {
    .decision .tile[data-done] { animation: decide .35s ease-out; }
    .decision:has([data-done]) img { animation: nod .4s ease-out; transform-origin: center 90%; }
    @keyframes nod { 50% { transform: rotate(4deg); } }
    @keyframes decide { from { transform: translateY(3px); } to { transform: none; } }
  }
</style>
<main>
  <div class="wrap hero center">
    <h1>手机伴侣</h1>
    <p class="lede">电脑在办事，你在路上也能确认。</p>
    <div class="cta">
      <span class="tag" style="align-self:center">规划中</span>
      <a class="btn btn-primary btn-lg" href={href('/download/')}><span><Icon name="desktop" size={17} /></span>先装桌面端</a>
      <a class="btn btn-lg" href="#weapp"><span><Icon name="wechat" size={17} /></span>微信小程序</a>
    </div>
  </div>

  
  <div class="stage" style="padding-top:64px">
    <label class="preview-picker" hidden>体验场景
      <select aria-controls="phone-previews"><option value="progress">看进展</option><option value="decision" selected>确认写入</option><option value="upload">发到项目</option></select>
    </label>
    <div class="phones" id="phone-previews">
      <div class="phone progress-demo">
        <div class="top">进展</div>
        <details class="tile"><summary>配方实验记录员</summary><p>正在整理 F-02 和 F-03 的实验记录。</p><span class="st run">进行中</span></details>
        <details class="tile"><summary>数据校验员</summary><p>按日核对检测表里的待测项。</p><span class="st">每天 08:00</span></details>
        <details class="tile"><summary>周报助手</summary><p>汇总本周的实验进展，保留出处。</p><span class="st">周五 17:00</span></details>
      </div>
      <div class="phone mid decision" id="decision-demo">
        <div class="top">写入确认 <span class="tag">交互示例</span></div>
        <img src={href('/brand/garwoo-confirm.webp')} alt="" width="240" height="240" />
        <div class="tile" role="status" aria-live="polite" aria-atomic="true"><b data-title>待你确认</b><span data-message>拟写入《候选配方对比.md》：F-02 三项达标，F-03 耐擦洗待测。</span></div>
        <details class="tile"><summary>查看依据</summary><p>配方实验记录 · F-02 检测表</p><p>耐擦洗记录 · F-03 待测项</p></details>
        <div class="act" data-choices hidden><button type="button" data-later>稍后</button><button type="button" data-confirm>确认写入</button></div>
        <div class="act" data-retry hidden><button type="button">再试一次</button></div>
      </div>
      <div class="phone upload-demo">
        <div class="top">发到项目 <span class="tag">交互示例</span></div>
        <div class="tile" style="height:140px;display:grid;place-items:center;background:var(--bg-2)"><span class="faint"><Icon name="file" size={30} /></span></div>
        <div class="tile"><b>水性涂料配方研发</b>B-1024 耐擦洗记录.jpg<div role="status" data-upload-status></div></div>
        <div class="act" style="grid-template-columns:1fr"><button type="button" data-upload hidden>模拟发送</button></div>
      </div>
    </div>
  </div>

  <div class="wrap">
    <section class="sec">
      <div class="grid g3">
        <div class="card media reveal"><div class="cover"><div class="panel" style="max-width:240px">
          <div class="row"><span>配方实验记录员</span><span class="st run">进行中</span></div>
          <div class="row"><span>数据校验员</span><span class="st">08:00</span></div>
          <div class="row"><span>周报助手</span><span class="st">周五</span></div></div></div><div class="body"><h3>看进展</h3></div></div>
        <div class="card media reveal"><div class="cover"><div class="panel" style="max-width:240px">
          <div class="hd">写入项目文件<span class="st warn">待确认</span></div>
          <div class="acts"><span class="mbtn">稍后</span><span class="mbtn p">确认</span></div></div></div><div class="body"><h3>确认写操作</h3></div></div>
        <div class="card media reveal"><div class="cover"><div class="panel" style="max-width:240px;display:flex;gap:10px;align-items:center">
          <span class="ic" style="margin:0"><Icon name="file" size={18} /></span>
          <div><b>B-1024 耐擦洗记录.jpg</b><div class="faint" style="font-size:12px">→ 水性涂料配方研发</div></div></div></div><div class="body"><h3>拍照发到项目</h3></div></div>
      </div>
    </section>

    
    <section class="sec">
      <div class="sec-head center"><h2>资料不离开你的电脑</h2></div>
      <div class="relay">
        <div class="card"><div class="ic"><Icon name="phone" size={18} /></div><b>手机</b></div>
        <span class="wire"></span>
        <div class="card"><div class="ic blue"><Icon name="lock" size={18} /></div><b>端到端加密中继</b></div>
        <span class="wire"></span>
        <div class="card"><div class="ic"><Icon name="desktop" size={18} /></div><b>你的电脑</b></div>
      </div>
      <p class="muted" style="text-align:center;margin-top:20px">中继只看得到连接时刻和密文长度；电脑离线时，密文最多暂存七天。</p>
    </section>

    <section class="sec" id="weapp">
      <div class="grid duo even">
        <div>
          <h2 style="font-size:clamp(28px,3.6vw,40px)">微信小程序</h2>
          <p class="muted" style="font-size:16px;margin-top:12px">不用装应用，扫码配对。</p>
          <span class="tag" style="margin-top:20px">规划中</span>
        </div>
        <div class="fv" style="padding:40px">
          <div class="phone wx">
            <span class="capsule"></span>
            <div class="top">格物</div>
            <div class="tile"><b>我的电脑</b>在线</div>
            <div class="tile"><b>周报草稿</b>每条注明出处</div>
            <div class="tile"><b>待你确认</b>1 项</div>
            <div class="act"><span>稍后</span><span class="p">查看</span></div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="final">
    <img class="mascot" src={href('/brand/mascot.webp')} alt="" width="512" height="512" />
    <h2>先装桌面端，再配手机。</h2>
    <div class="cta"><a class="btn btn-primary btn-lg" href={href('/download/')}>{cta.label}</a></div>
  </div>
</main>
<script>
  const previews = document.querySelector<HTMLElement>('#phone-previews')!;
  const picker = document.querySelector<HTMLElement>('.preview-picker')!;
  const scene = picker.querySelector('select')!;
  function selectScene() { previews.dataset.view = scene.value; }
  selectScene();
  scene.addEventListener('change', selectScene);
  picker.hidden = false;
  const upload = previews.querySelector<HTMLButtonElement>('[data-upload]')!;
  const uploadStatus = previews.querySelector<HTMLElement>('[data-upload-status]')!;
  upload.hidden = false;
  upload.addEventListener('click', () => {
    const sent = !uploadStatus.textContent;
    uploadStatus.textContent = sent ? '示例照片已加入项目。' : '';
    upload.textContent = sent ? '重置示例' : '模拟发送';
  });
  const demo = document.querySelector<HTMLElement>('#decision-demo')!;
  const choices = demo.querySelector<HTMLElement>('[data-choices]')!;
  const retry = demo.querySelector<HTMLElement>('[data-retry]')!;
  const title = demo.querySelector<HTMLElement>('[data-title]')!;
  const message = demo.querySelector<HTMLElement>('[data-message]')!;
  const original = message.textContent;
  const confirm = demo.querySelector<HTMLButtonElement>('[data-confirm]')!;
  const again = retry.querySelector('button')!;
  choices.hidden = false;
  function decide(accepted: boolean) {
    title.textContent = accepted ? '示例已采纳' : '已留待确认';
    message.textContent = accepted ? '两条结论已列入示例对比文件，保留各自的实验出处。' : '这次先保留草稿，等耐擦洗结果回来再决定。';
    title.parentElement!.setAttribute('data-done', '');
    choices.hidden = true;
    retry.hidden = false;
    again.textContent = accepted ? '再试一次' : '回到草稿';
    again.focus({ preventScroll: true });
  }
  confirm.addEventListener('click', () => decide(true));
  demo.querySelector('[data-later]')!.addEventListener('click', () => decide(false));
  again.addEventListener('click', () => {
    title.textContent = '待你确认';
    message.textContent = original;
    title.parentElement!.removeAttribute('data-done');
    retry.hidden = true;
    choices.hidden = false;
    confirm.focus({ preventScroll: true });
  });
</script>
</Base>
