---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
import { RELEASES } from '../data/changelog';
import { platformStatus } from '../data/status';
import Icon from '../components/Icon.astro';
const win = await platformStatus('windows');
const and = await platformStatus('android');
const wm = win.manifest;
const am = and.manifest;
const mb = (n: number) => `${(n / 1048576).toFixed(1)} MB`;
const day = (iso: string) => iso.slice(0, 10);
const unsigned = wm?.signature?.status === 'NotSigned';
const desc = wm
  ? `下载格物：Windows ${wm.version} ${win.label}${unsigned ? '，安装包未签名' : ''}。`
  : '下载格物：Windows 0.2.1 邀请内测，macOS、Android 与微信小程序规划中。';
const latest = RELEASES[0];
---
<Base title="下载" description={desc} page="download">
<style is:global>
.dl{display:grid;grid-template-columns:1.3fr .7fr;gap:16px}
.dl .main{display:flex;flex-direction:column;min-height:380px;padding:36px;position:relative;overflow:hidden}
.dl .main h2{font-size:clamp(30px,3.6vw,40px);margin-top:20px}
.dl .main .cta{margin-top:auto;display:flex;gap:10px;flex-wrap:wrap}
.dl .main .big{position:absolute;right:32px;bottom:28px;width:150px;height:150px}
.dl .side-col{display:grid;gap:16px}
.plat{display:flex;align-items:center;gap:14px;padding:22px}
.plat .ic{margin:0}
.plat b{font-size:16px;display:block;line-height:1.3}
.plat .r{margin-left:auto}
@media (max-width:900px){.dl{grid-template-columns:1fr}.dl .main{padding:24px;min-height:320px}.dl .main .big{width:90px;height:90px;right:20px;bottom:auto;top:20px}}
.req{width:100%;border-collapse:collapse;font-size:15px}
.req td{padding:14px 0;border-bottom:1px solid var(--line)}
.req td:first-child{color:var(--muted);width:30%}
.req code{word-break:break-all;font-size:13px}
.dl .main .facts{margin:14px 0 22px;display:grid;gap:4px;max-width:calc(100% - 180px)}
.dl .notice{margin:0 0 18px;padding:12px 14px;border:1px solid var(--line-strong);border-radius:12px;font-size:14px;max-width:calc(100% - 180px)}
@media (max-width:900px){.dl .main .facts,.dl .notice{max-width:100%}}
</style>
<main>
  <div class="wrap hero center" style="padding-bottom:48px"><h1>下载格物</h1></div>
  <div class="wrap">

    <div class="dl">
      <div class="card main">
        <div class="ic blue" style="width:48px;height:48px;margin:0"><Icon name="win" size={22} /></div>
        <h2>Windows</h2>
        {wm ? (
          <>
            <div class="facts">
              <p class="muted">{wm.version} · {win.label} · {day(wm.published_at)} · {mb(wm.size)}</p>
              <p class="faint" style="font-size:14px">Windows 10 / 11，64 位</p>
            </div>
            {unsigned ? <p class="notice">这个安装包没有代码签名。Windows 安装时会提示“未知发布者”，请先在下方核对 SHA-256，再选择“更多信息 → 仍要运行”。</p> : null}
            <div class="cta">
              <a class="btn btn-primary btn-lg" href={wm.urls[0]}><span><Icon name="download" size={17} /></span>下载 Windows 版</a>
              {wm.alternates?.map((a) => <a class="btn btn-lg" href={a.urls[0]}>{a.file.endsWith('.msi') ? 'MSI 安装包' : a.file}</a>)}
            </div>
          </>
        ) : (
          <>
            <p class="muted">{latest.version} · {win.label}</p>
            <div class="cta">
              <a class="btn btn-primary btn-lg" href={href('/docs/trial/')}><span><Icon name="download" size={17} /></span>申请内测</a>
            </div>
          </>
        )}
        <img class="big mascot" src={href('/brand/mascot.webp')} alt="" width="512" height="512" />
      </div>
      <div class="side-col">
        <div class="card plat"><div class="ic"><Icon name="apple" size={18} /></div><div><b>macOS</b><span class="faint">规划中</span></div></div>
        <div class="card plat"><div class="ic"><Icon name="android" size={18} /></div><div><b>Android</b><span class="faint">{am ? `${am.version} · ${and.label}` : and.label}</span></div>
          {am ? <a class="btn btn-sm r" href={am.urls[0]}>下载</a> : <a class="btn btn-sm r" href={href('/mobile/')}>了解</a>}</div>
        <div class="card plat" id="weapp"><div class="ic"><Icon name="wechat" size={18} /></div><div><b>微信小程序</b><span class="faint">规划中</span></div><a class="btn btn-sm r" href={href('/mobile/#weapp')}>了解</a></div>
      </div>
    </div>

    {(wm || am) ? (
      <section class="sec" id="verify">
        <div class="grid duo even" style="align-items:start">
          <h2 style="font-size:clamp(26px,3.2vw,36px)">安装与核对</h2>
          <table class="req">
            {wm ? (
              <>
                <tr><td>Windows SHA-256</td><td><code>{wm.sha256}</code></td></tr>
                {wm.alternates?.map((a) => <tr><td>{a.file.endsWith('.msi') ? 'MSI SHA-256' : `${a.file} SHA-256`}</td><td><code>{a.sha256}</code></td></tr>)}
                <tr><td>签名</td><td>{wm.signature?.status === 'Valid' ? `已签名：${wm.signature.signer_subject}（指纹 ${wm.signature.signer_thumbprint}）` : '未签名。核对上面的 SHA-256 后再安装。'}</td></tr>
                <tr><td>核对方法</td><td>在 PowerShell 里执行 <code>Get-FileHash 安装包路径</code>，结果应与上面一致。</td></tr>
              </>
            ) : null}
            {am ? (
              <>
                <tr><td>Android SHA-256</td><td><code>{am.sha256}</code></td></tr>
                <tr><td>签名证书指纹</td><td><code>{am.cert_sha256}</code></td></tr>
                <tr><td>安装</td><td>用浏览器下载后，按系统提示允许该浏览器安装应用。系统要求 API 级别 {am.min_os_sdk} 以上。更新时证书指纹必须与已装版本一致，否则系统会拒绝安装。</td></tr>
              </>
            ) : null}
          </table>
        </div>
      </section>
    ) : null}

    <section class="sec">
      <div class="grid duo even" style="align-items:start">
        <h2 style="font-size:clamp(26px,3.2vw,36px)">系统要求</h2>
        <table class="req">
          <tr><td>系统</td><td>Windows 10 / 11，64 位</td></tr>
          <tr><td>网络</td><td>官方 AI 与登录需联网，其余可离线</td></tr>
          <tr><td>模型</td><td>官方 AI，或 OpenAI 兼容接口、本机 Ollama</td></tr>
        </table>
      </div>
    </section>

    <section class="sec">
      <div class="sec-head split"><h2>更新日志</h2><a class="link" href={href('/changelog/')}>全部版本</a></div>
      <div class="grid g3">
        {RELEASES.map((r) => (
          <a class="card" href={href(`/changelog/#v${r.version}`)}><span class="faint" style="font-size:13px">{r.date}</span><h3 style="margin-top:8px">{r.version}</h3></a>
        ))}
      </div>
    </section>
  </div>
</main>
</Base>
