---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
import Icon from '../components/Icon.astro';
import { PACKS, EXAMPLES } from '../data/packs';

const domainBadge: Record<string, string> = {
  '离散制造': 'emerald',
  '研发实验': 'violet',
  '组织经营': 'blue',
};

const domainDesc: Record<string, string> = {
  '组织经营': '面向独立研究者、一人公司与工作室，管理项目、委托契约、流程与交付成果。',
  '研发实验': '面向实验室与研发团队，管理原料、配方版本、实验批次、性能表征与结论。',
  '离散制造': '面向制造现场与工厂产线，快速搭建设备、工位、SOP 与质量追溯本体。',
};

const featured = PACKS.find(p => p.slug === 'personal-opc')!;
const formulation = PACKS.find(p => p.slug === 'formulation-team')!;
const domains = ['组织经营', '研发实验', '离散制造'] as const;
---
<Base og="og-packs" title="本体市场" description="从专业包开始构建自己的领域。查看一人公司、配方研发组、隐形眼镜工厂起步包，以及七种项目任务示例。" page="packs">
<style is:global>
.mk-wrap{max-width:980px;margin:0 auto;padding:48px 32px 64px}
@media (max-width:640px){.mk-wrap{padding:32px 16px 48px}}
.mk-top{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-bottom:20px;border-bottom:1px solid var(--line)}
.mk-top h1{font-size:clamp(28px,3.6vw,40px);letter-spacing:-.025em}
.mk-top .sub{margin-top:6px;font-size:15px;color:var(--muted);max-width:560px}
.mk-pills{display:inline-flex;gap:2px;padding:3px;border-radius:999px;background:var(--panel-2);border:1px solid var(--line)}
.mk-pills button{height:30px;padding:0 14px;border:0;border-radius:999px;background:none;font-size:13px;color:var(--muted);cursor:pointer;white-space:nowrap}
.mk-pills button[aria-selected="true"]{background:var(--panel);color:var(--ink);font-weight:500;box-shadow:0 1px 2px rgba(16,24,40,.08)}

.mk-toolbar{margin-top:20px;display:flex;flex-direction:column;gap:12px}
.mk-search{display:flex;align-items:center;gap:10px;width:100%;height:42px;padding:0 16px;border-radius:999px;background:var(--panel-2);border:1px solid var(--line);color:var(--faint);transition:border-color .15s,background .15s}
.mk-search:focus-within{border-color:var(--primary);background:var(--panel)}
.mk-search input{flex:1;border:0;background:none;font:inherit;font-size:14px;color:var(--ink);outline:none;min-width:0}
.mk-chips{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.mk-chips button{height:28px;padding:0 12px;border-radius:999px;border:1px solid transparent;background:var(--panel-2);color:var(--muted);font-size:12px;cursor:pointer;transition:background .15s,color .15s}
.mk-chips button:hover{color:var(--ink)}
.mk-chips button[aria-selected="true"]{background:var(--ink);color:var(--panel);font-weight:500}

.mk-hero{margin-top:24px;display:grid;grid-template-columns:1.08fr .92fr;border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--panel);box-shadow:0 1px 3px rgba(16,24,40,.04)}
.mk-hero .art{min-height:240px;background:linear-gradient(135deg,var(--primary-soft),var(--bg-2) 55%,var(--primary-soft));border-right:1px solid var(--line);display:grid;place-items:center;padding:28px;position:relative;overflow:hidden}
.mk-hero .art::before{content:"";position:absolute;inset:0;background-image:radial-gradient(var(--dot) 1px,transparent 1px);background-size:18px 18px}
.mk-hero .tile-grid{position:relative;display:grid;grid-template-columns:repeat(3,56px);gap:14px}
.mk-hero .tile{width:56px;height:56px;border-radius:16px;background:var(--panel);border:1px solid var(--line);box-shadow:0 6px 16px rgba(16,24,40,.08);display:grid;place-items:center;color:var(--primary)}
.mk-hero .tile.t1{transform:rotate(-6deg);color:#2563eb}
.mk-hero .tile.t2{transform:translateY(6px);color:#7c3aed}
.mk-hero .tile.t3{transform:rotate(6deg);color:#059669}
.mk-hero .tile.t4{transform:rotate(3deg);color:#d97706}
.mk-hero .tile.t5{transform:translateY(-4px);color:var(--primary)}
.mk-hero .tile.t6{transform:rotate(-4deg);color:#0891b2}
.mk-hero .txt{padding:28px 32px;display:flex;flex-direction:column;gap:10px;justify-content:center}
.mk-hero .eyebrow{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--primary);display:inline-flex;align-items:center;gap:6px}
.mk-hero h2{font-size:24px}
.mk-hero p{font-size:14px;color:var(--muted);line-height:1.6}
.mk-hero .meta{font-size:12px;color:var(--faint)}
.mk-hero .cta{margin-top:8px;display:flex;gap:10px;flex-wrap:wrap}
@media (max-width:860px){.mk-hero{grid-template-columns:1fr}.mk-hero .art{border-right:0;border-bottom:1px solid var(--line);min-height:190px}.mk-hero .txt{padding:22px}}

.mk-shelf{margin-top:32px;padding-top:24px;border-top:1px solid var(--line)}
.mk-shelf:first-of-type{border-top:0;padding-top:0}
.mk-shelf-hd{margin-bottom:14px;display:flex;justify-content:space-between;align-items:baseline;gap:12px}
.mk-shelf-hd h2{font-size:17px;display:inline-flex;align-items:center;gap:6px}
.mk-shelf-hd p{font-size:13px;color:var(--muted);margin-top:3px}
.mk-rows{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
@media (max-width:720px){.mk-rows{grid-template-columns:1fr}}

.mk-row{display:flex;align-items:center;gap:14px;padding:14px 16px;border:1px solid var(--line);border-radius:14px;background:var(--panel);transition:border-color .15s,background .15s;min-width:0}
a.mk-row:hover,.mk-row.hover:hover{border-color:var(--line-strong);background:var(--bg-2)}
.mk-ic{width:46px;height:46px;border-radius:12px;border:1px solid var(--line);display:grid;place-items:center;flex:none;background:var(--primary-soft);color:var(--primary)}
.mk-ic.blue{background:rgba(37,99,235,.1);color:#2563eb;border-color:rgba(37,99,235,.2)}
.mk-ic.violet{background:rgba(124,58,237,.1);color:#7c3aed;border-color:rgba(124,58,237,.2)}
.mk-ic.emerald{background:rgba(5,150,105,.1);color:#059669;border-color:rgba(5,150,105,.2)}
.mk-ic.neutral{background:var(--panel-2);color:var(--ink-soft);border-color:var(--line)}
.mk-info{flex:1;min-width:0}
.mk-title{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.mk-title h3{font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mk-desc{margin-top:3px;font-size:13px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mk-meta{margin-top:4px;font-size:11px;color:var(--faint);display:flex;gap:6px;flex-wrap:wrap}
.mk-act{flex:none;display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 12px;border-radius:8px;border:1px solid var(--line);background:var(--panel);font-size:12px;font-weight:500;color:var(--ink);white-space:nowrap;transition:border-color .15s,background .15s,color .15s}
a.mk-row:hover .mk-act{border-color:var(--primary);background:var(--primary);color:#fff}
.pack[hidden],.mk-shelf[hidden],.mk-hero[hidden]{display:none}
</style>
<main>
  <div class="mk-wrap">
    <div class="mk-top">
      <div>
        <h1>本体市场</h1>
        <p class="sub">选一个专业包，领域结构、出处文章和智能体配置一起装入项目。内置的本体包称为起步包，可按你的目标继续调整。</p>
      </div>
      <div class="mk-pills" id="view-tabs" role="tablist" aria-label="市场分类视图">
        <button type="button" role="tab" aria-selected="true" data-view="all">全部市场</button>
        <button type="button" role="tab" aria-selected="false" data-view="starter">官方起步包</button>
        <button type="button" role="tab" aria-selected="false" data-view="example">任务示例</button>
      </div>
    </div>

    <div class="mk-toolbar">
      <label class="mk-search">
        <span><Icon name="search" size={16} /></span>
        <input id="q" placeholder="搜索行业、对象或智能体" aria-label="搜索本体包" />
      </label>
      <div class="mk-chips" id="chips" role="tablist" aria-label="领域筛选">
        <button type="button" role="tab" aria-selected="true" data-k="">全部领域</button>
        <button type="button" role="tab" aria-selected="false" data-k="组织经营">组织经营</button>
        <button type="button" role="tab" aria-selected="false" data-k="研发实验">研发实验</button>
        <button type="button" role="tab" aria-selected="false" data-k="离散制造">离散制造</button>
        <button type="button" role="tab" aria-selected="false" data-k="示例项目">任务示例</button>
      </div>
    </div>

    <div class="mk-hero" id="featured-hero">
      <div class="art" aria-hidden="true">
        <div class="tile-grid">
          <div class="tile t1"><Icon name="users" size={24} /></div>
          <div class="tile t2"><Icon name="flask" size={24} /></div>
          <div class="tile t3"><Icon name="building" size={24} /></div>
          <div class="tile t4"><Icon name="boxes" size={22} /></div>
          <div class="tile t5"><Icon name="bot" size={24} /></div>
          <div class="tile t6"><Icon name="graph" size={22} /></div>
        </div>
      </div>
      <div class="txt">
        <span class="eyebrow"><Icon name="spark" size={13} /> 官方精选 · {featured.version}</span>
        <h2>一人公司起步包</h2>
        <p>创始人、虚拟部门、委托契约、流程与交付成果，装入后即可由一人与 AI 代理协同经营。</p>
        <p class="meta">{featured.counts.types} 个类型 · {featured.counts.examples} 个示例对象 · {featured.counts.sources} 篇出处 · {featured.counts.agents} 位智能体</p>
        <div class="cta">
          <a class="btn btn-primary btn-sm" style="border-radius:999px;padding:0 16px" href={href('/docs/quickstart/#setup-domain')}>查看安装步骤</a>
          <a class="btn btn-sm" style="border-radius:999px;padding:0 16px" href={href('/packs/personal-opc/')}>查看包内容</a>
        </div>
      </div>
    </div>

    <div id="packs">
      {domains.map((dom) => {
        const domPacks = PACKS.filter((p) => p.domain === dom);
        return (
          <section class="mk-shelf" data-shelf="starter">
            <div class="mk-shelf-hd">
              <div>
                <h2>{dom}</h2>
                <p>{domainDesc[dom]}</p>
              </div>
            </div>
            <div class="mk-rows">
              {domPacks.map((p) => (
                <a class="mk-row pack" data-kind="starter" href={href(`/packs/${p.slug}/`)} data-k={p.keywords}>
                  <span class={`mk-ic ${domainBadge[p.domain] || 'blue'}`}>
                    <Icon name={p.icon} size={22} />
                  </span>
                  <div class="mk-info">
                    <div class="mk-title">
                      <h3>{p.title}</h3>
                      <span class="tag blue">官方起步包</span>
                    </div>
                    <p class="mk-desc">{p.sub}</p>
                    <div class="mk-meta">
                      <span>{p.domain}</span>
                      <span>·</span>
                      <span>{p.counts.types} 个类型</span>
                      <span>·</span>
                      <span>{p.counts.examples} 个示例对象</span>
                      <span>·</span>
                      <span>{p.counts.agents} 位智能体</span>
                      <span>·</span>
                      <span>v {p.version}</span>
                    </div>
                  </div>
                  <span class="mk-act">+ 查看详情</span>
                </a>
              ))}
            </div>
          </section>
        );
      })}

      <section class="mk-shelf" data-shelf="example">
        <div class="mk-shelf-hd">
          <div>
            <h2>任务示例</h2>
            <p>在支持内置示例的客户端，可从新建项目入口导入这七个示例。示例日程默认暂停。</p>
          </div>
        </div>
        <div class="mk-rows">
          {EXAMPLES.map((e) => (
            <article class="mk-row pack hover" data-kind="example" data-k={e.keywords}>
              <span class="mk-ic neutral">
                <Icon name={e.icon} size={20} />
              </span>
              <div class="mk-info">
                <div class="mk-title">
                  <h3>{e.title}</h3>
                  <span class="tag">{e.tag}</span>
                </div>
                <p class="mk-desc">按行业本体组织原件、出处与智能体协作的任务样板。</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>

    <p id="empty" class="faint" style="text-align:center;padding:48px 0" hidden>没有找到，换个词试试。</p>

    <section class="sec" style="padding-top:72px">
      <div class="grid duo even">
        <div>
          <h2 style="font-size:clamp(26px,3.2vw,36px)">把你的本体做成包</h2>
          <p class="muted" style="font-size:15px;margin-top:12px">导出为起步包，类型、示例、出处和智能体一起带走。升级时保留你的修改。</p>
        </div>
        <div class="fv" style="min-height:280px;padding:28px">
          <div class="panel">
            <div class="hd">配方研发组起步包 · {formulation.version}</div>
            <div class="row"><span>类型</span><b>10</b></div>
            <div class="row"><span>示例对象</span><b>{formulation.counts.examples}</b></div>
            <div class="row"><span>出处文章</span><b>14</b></div>
            <div class="row"><span>智能体</span><b>3</b></div>
            <div class="row"><span>发布到市场</span><span class="tag">规划中</span></div>
            <div class="acts"><span class="mbtn p">导出起步包</span></div>
          </div>
        </div>
      </div>
    </section>
  </div>
</main>
<script is:inline>
(function () {
  var q = document.getElementById('q'), key = '', view = 'all';
  var chips = document.querySelectorAll('#chips button');
  var viewTabs = document.querySelectorAll('#view-tabs button');
  var packs = document.querySelectorAll('#packs .pack');
  var shelves = document.querySelectorAll('#packs .mk-shelf');
  var hero = document.getElementById('featured-hero');
  var empty = document.getElementById('empty');
  function apply() {
    var t = q.value.trim().toLocaleLowerCase(), n = 0;
    packs.forEach(function (p) {
      var hay = p.dataset.k + ' ' + p.textContent;
      var kindOk = view === 'all' || p.dataset.kind === view;
      var ok = kindOk && (!key || hay.includes(key)) && (!t || hay.toLocaleLowerCase().includes(t));
      p.hidden = !ok; if (ok) n++;
    });
    shelves.forEach(function (s) {
      var visibleInShelf = s.querySelectorAll('.pack:not([hidden])').length;
      s.hidden = visibleInShelf === 0;
    });
    if (hero) hero.hidden = Boolean(t || key || view === 'example');
    empty.hidden = n > 0;
  }
  chips.forEach(function (c) { c.addEventListener('click', function () {
    key = c.dataset.k; chips.forEach(function (x) { x.setAttribute('aria-selected', x === c); }); apply();
  }); });
  viewTabs.forEach(function (b) { b.addEventListener('click', function () {
    view = b.dataset.view; viewTabs.forEach(function (x) { x.setAttribute('aria-selected', x === b); }); apply();
  }); });
  q.addEventListener('input', apply);
})();
</script>
</Base>
