---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
import Icon from '../components/Icon.astro';
import { PACKS, EXAMPLES, PACK_VERSION } from '../data/packs';
---
<Base og="og-packs" title="本体市场" description="格物本体市场：一个包就是一个领域，含隐形眼镜工厂、配方研发组、一人公司三个起步包。" page="packs">
<style is:global>
.search{display:flex;align-items:center;gap:10px;max-width:560px;margin:28px auto 0;height:44px;padding:0 14px;border-radius:8px;background:var(--panel);border:1px solid var(--line-strong);color:var(--faint)}
.search:focus-within{outline:2px solid var(--primary);outline-offset:-1px}
.search input{flex:1;border:0;background:none;font:inherit;font-size:15px;color:var(--ink);outline:none;min-width:0}
.feat-pack{display:grid;grid-template-columns:1.1fr .9fr;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--panel)}
.feat-pack .art{min-height:340px;border-right:1px solid var(--line)}
.feat-pack .txt{padding:40px;display:flex;flex-direction:column;gap:16px;justify-content:center}
@media (max-width:860px){.feat-pack{grid-template-columns:1fr}.feat-pack .art{border-right:0;border-bottom:1px solid var(--line);min-height:260px}.feat-pack .txt{padding:24px}}
.pack .cover{height:150px}
.pack[hidden]{display:none}
</style>
<main>
  <div class="wrap hero center" style="padding-bottom:40px">
    <h1>一个包，一个领域</h1>
    <label class="search"><span><Icon name="search" size={17} /></span><input id="q" placeholder="搜索行业、对象或智能体" aria-label="搜索本体包"></label>
    <div style="margin-top:18px"><div class="seg" id="chips" role="tablist">
      <button aria-selected="true" data-k="">全部</button><button aria-selected="false" data-k="离散制造">离散制造</button><button aria-selected="false" data-k="研发实验">研发实验</button><button aria-selected="false" data-k="组织经营">组织经营</button><button aria-selected="false" data-k="示例项目">示例项目</button>
    </div></div>
  </div>

  
  <div class="wrap">
    <div class="feat-pack reveal">
      <div class="art fv" style="border:0;border-radius:0">
        <svg viewBox="0 0 520 320" style="width:100%;max-width:480px" aria-hidden="true">
          <g stroke="var(--line-strong)" stroke-width="1.5" fill="none"><path d="M260 160 130 70M260 160 400 70M260 160 120 250M260 160 400 250M260 160 260 50M260 160 260 280"/></g>
          <g font-size="13" text-anchor="middle" font-family="inherit">
            <rect x="205" y="138" width="110" height="44" rx="8" fill="var(--primary)"/><text x="260" y="165" fill="#fff" font-weight="600">工序工位</text>
            <rect x="80" y="50" width="100" height="40" rx="8" fill="var(--panel)" stroke="var(--line-strong)"/><text x="130" y="75" fill="var(--ink)">检测计划</text>
            <rect x="350" y="50" width="100" height="40" rx="8" fill="var(--panel)" stroke="var(--line-strong)"/><text x="400" y="75" fill="var(--ink)">缺陷词表</text>
            <rect x="210" y="14" width="100" height="36" rx="8" fill="var(--panel)" stroke="var(--line-strong)"/><text x="260" y="37" fill="var(--ink)">示例设备</text>
            <rect x="60" y="230" width="120" height="40" rx="8" fill="var(--panel)" stroke="var(--line-strong)"/><text x="120" y="255" fill="var(--ink)">受控标准引用</text>
            <rect x="345" y="230" width="110" height="40" rx="8" fill="var(--panel)" stroke="var(--line-strong)"/><text x="400" y="255" fill="var(--ink)">SOP/WI 引用</text>
            <rect x="210" y="270" width="100" height="36" rx="8" fill="var(--panel)" stroke="var(--line-strong)"/><text x="260" y="293" fill="var(--ink)">异常案例</text>
          </g>
        </svg>
      </div>
      <div class="txt">
        <span class="tag blue" style="width:fit-content">官方精选 · 1.1.0</span>
        <h2 style="font-size:32px">隐形眼镜工厂起步包</h2>
        <p class="muted" style="font-size:16px">干湿双线工厂：产线、工位、检测、缺陷、标准与 SOP。</p>
        <p class="faint" style="font-size:14px">7 个类型 · 28 个示例对象 · 12 篇出处 · 3 位智能体</p>
        <div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn btn-primary" href={href('/download/')}>在格物中安装</a><a class="btn" href={href('/packs/contact-lens-factory/')}>查看包内容</a></div>
      </div>
    </div>

    <section class="sec-sm">
      <div class="grid g3" id="packs">
        {PACKS.map((p) => (
          <a class="card media pack hover" href={href(`/packs/${p.slug}/`)} data-k={p.keywords}><div class="cover"><span class="ic blue" style="margin:0;width:52px;height:52px;border-radius:12px"><Icon name={p.icon} size={24} /></span></div><div class="body"><h3>{p.title.replace(/起步包$/, '')}</h3><span class="tag">{PACK_VERSION} · {p.counts[0]} 个类型</span></div></a>
        ))}
        {EXAMPLES.map((e) => (
          <article class="card media pack hover" data-k={e.keywords}><div class="cover"><span class="ic" style="margin:0;width:52px;height:52px;border-radius:12px"><Icon name={e.icon} size={24} /></span></div><div class="body"><h3>{e.title}</h3><span class="tag">{e.tag}</span></div></article>
        ))}
      </div>
      <p id="empty" class="faint" style="text-align:center;padding:48px 0" hidden>没有找到，换个词试试。</p>
    </section>

    <section class="sec">
      <div class="grid duo even">
        <div>
          <h2 style="font-size:clamp(28px,3.6vw,40px)">把你的本体做成包</h2>
          <p class="muted" style="font-size:16px;margin-top:12px">导出为起步包，类型、示例、出处和智能体一起带走。升级时保留你的修改。</p>
        </div>
        <div class="fv" style="min-height:320px">
          <div class="panel">
            <div class="hd">配方研发组起步包 · 1.1.0</div>
            <div class="row"><span>类型</span><b>10</b></div>
            <div class="row"><span>示例对象</span><b>153</b></div>
            <div class="row"><span>出处文章</span><b>14</b></div>
            <div class="row"><span>智能体</span><b>3</b></div>
            <div class="row"><span>发布到市场</span><span class="tag">规划中</span></div>
            <div class="acts"><span class="mbtn p">导出起步包</span></div>
          </div>
        </div>
      </div>
    </section>
  </div>
</main>
<script is:inline>
(function () {
  var q = document.getElementById('q'), key = '', chips = document.querySelectorAll('#chips button');
  var packs = document.querySelectorAll('#packs .pack'), empty = document.getElementById('empty');
  function apply() {
    var t = q.value.trim(), n = 0;
    packs.forEach(function (p) {
      var hay = p.dataset.k + ' ' + p.textContent;
      var ok = (!key || hay.indexOf(key) >= 0) && (!t || hay.indexOf(t) >= 0);
      p.hidden = !ok; if (ok) n++;
    });
    empty.hidden = n > 0;
  }
  chips.forEach(function (c) { c.addEventListener('click', function () {
    key = c.dataset.k; chips.forEach(function (x) { x.setAttribute('aria-selected', x === c); }); apply();
  }); });
  q.addEventListener('input', apply);
})();
</script>
</Base>
