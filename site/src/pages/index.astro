---
import Base from '../layouts/Base.astro';
import HomeStory from '../components/HomeStory.astro';
import { ENDPOINTS } from '../lib/target';
import { href } from '../lib/url';
import { getLocale } from '../lib/i18n';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: '格物 Garwoo',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Windows 10, Windows 11',
  description: 'An ontology-driven decision system for organizing domain knowledge, agents, and workflows from goals to execution.',
  url: ENDPOINTS.site + '/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY', description: '客户端免费，官方 AI 按积分计费' },
};
---
<Base og="og-home" jsonLd={jsonLd} description="Follow a task from goal to recorded result." page="home">
  <script define:vars={{ examplesPage: href('/how/') }}>
    function forwardExampleLink() {
      if (/^#examples$|^#example-[a-z0-9-]+$/.test(location.hash)) {
        location.replace(examplesPage + location.hash);
      }
    }
    forwardExampleLink();
    addEventListener('hashchange', forwardExampleLink);
  </script>
  <main id="main">
    <HomeStory locale={getLocale(Astro.url)} />
  </main>
</Base>
