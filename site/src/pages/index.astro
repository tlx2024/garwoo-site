---
import Base from '../layouts/Base.astro';
import CompanionOutcomes from '../components/CompanionOutcomes.astro';
import { href } from '../lib/url';
import { ENDPOINTS } from '../lib/target';
import Icon from '../components/Icon.astro';
import ProjectExplorer from '../components/ProjectExplorer.astro';
const domains = [
 {slug:'personal-opc',icon:'users',title:'智能体公司',sub:'一个人，也能按岗位开展工作。',roles:['销售','市场','产品','会计'],body:'围绕经营目标，组织岗位与任务。从线索跟进到交付草稿，每件事都有分工。',pack:'一人公司起步包'},
 {slug:'formulation-team',icon:'flask',title:'科研实验室',sub:'让研究目标落到每一次实验。',roles:['配方','批次','实测','指标'],body:'把配方、实验和结果对应起来。智能体整理记录，按目标比较，帮你准备下一轮实验。',pack:'配方研发组起步包'},
 {slug:'contact-lens-factory',icon:'building',title:'设备工厂',sub:'围绕设备与工序，组织现场工作。',roles:['产线','设备','工序','质检'],body:'把设备档案、作业规程与异常记录放进同一领域，关联负责这些任务的智能体。',pack:'隐形眼镜工厂起步包'},
];
const jsonLd = {'@context':'https://schema.org','@type':'SoftwareApplication',name:'格物 Garwoo',applicationCategory:'BusinessApplication',operatingSystem:'Windows 10, Windows 11',description:'本体驱动的决策系统。用专业包组织领域知识、智能体与工作流程，从目标走到任务执行。',url:ENDPOINTS.site+'/',offers:{'@type':'Offer',price:'0',priceCurrency:'CNY',description:'客户端免费，官方 AI 按积分计费'}};
import { windowsCta } from '../data/status';
const cta = await windowsCta();
---
<Base og="og-home" jsonLd={jsonLd} description="让 AI 帮你构建自己的专业领域。用专业包搭建智能体公司、科研实验室或设备工厂的工作体系，从目标到知识、决策与任务执行。" page="home">
<main>
  <section class="wrap hero domain-hero">
    <span class="tag blue">本体驱动的决策系统 · {cta.status}</span>
    <h1>让 AI 帮你构建<br><span class="p">自己的专业领域</span></h1>
    <p class="lede">从你的目标出发，用专业包搭起一套能开展工作的体系。<br>把领域知识和智能体组织起来，让任务从判断走到执行。</p>
    <div class="cta"><a class="btn btn-primary btn-lg" href="#domains">选择你的领域 ↓</a><a class="btn btn-lg" href="#examples">看七个项目怎么做</a></div>
  </section>

  <section class="wrap domain-section" id="domains" aria-labelledby="domains-title">
    <div class="section-intro"><div><span class="eyebrow">从专业包起步</span><h2 id="domains-title">你想搭建什么？</h2></div><p>领域结构、专业知识和示例智能体一起装入项目，再按你的目标调整。</p></div>
    <div class="domain-grid">{domains.map((d,i)=><article class="domain-card">
      <div class="domain-card-top"><span class="ic blue"><Icon name={d.icon} size={22}/></span><span class="domain-number">0{i+1}</span></div>
      <h3>{d.title}</h3><p class="domain-sub">{d.sub}</p>
      <div class="domain-roles">{d.roles.map(r=><span>{r}</span>)}</div>
      <p class="domain-body">{d.body}</p><a class="domain-link" href={href(`/packs/${d.slug}/`)}>{d.pack} <span aria-hidden="true">↗</span></a>
    </article>)}</div>
    <p class="scope-note">内置起步包提供示例配置。设备场景可先从档案与数据开始；真实设备控制需完成适配接入与现场验收。</p>
  </section>

  <section class="system-band">
    <div class="wrap">
      <div class="section-intro"><div><span class="eyebrow">一套相互关联的工作体系</span><h2>从目标开始，做到有结果。</h2></div><a class="link" href={href('/how/')}>了解工作方式 ↗</a></div>
      <ol class="work-chain">
        <li><span>01</span><h3>定目标</h3><p>要完成什么？<br>什么结果才算达到要求？</p></li>
        <li><span>02</span><h3>组织知识</h3><p>本体确定对象和规则，<br>资料对应到具体工作。</p></li>
        <li><span>03</span><h3>作出决策</h3><p>结合证据与约束，<br>比较可选的下一步。</p></li>
        <li><span>04</span><h3>开展任务</h3><p>交给有相应技能的智能体，<br>涉及设备时按接入范围执行。</p></li>
        <li><span>05</span><h3>带回结果</h3><p>记录实际发生的事，<br>为下次判断补充依据。</p></li>
      </ol>
      <div class="system-foundation"><strong>本体把这些环节关联起来。</strong><span>谁负责、用什么资料、遵守什么规则，都围绕同一个目标。</span></div>
    </div>
  </section>

  <ProjectExplorer />
  <CompanionOutcomes />

  <section class="wrap decision-preview">
    <div><span class="eyebrow">把其中一次决策展开看看</span><h2>下一轮实验，为什么先补测这一项？</h2><p>从研发目标到批次记录，看本体怎样组织依据，帮助你安排下一步。</p><a class="link" href={href('/how/#decision-story')}>看完整配方示例 ↗</a></div>
    <div class="decision-slip"><div class="slip-top"><strong>F-03 · 实验 B-1024</strong><span class="tag">示例</span></div><dl><div><dt>粘度 / 对比率</dt><dd>已有实测记录</dd></div><div><dt>耐擦洗</dt><dd class="missing">待测</dd></div><div><dt>下一步建议</dt><dd>补测后再比较</dd></div></dl><p>实验安排由研发人员确认。</p></div>
  </section>

  <section class="wrap start-section"><div class="section-intro"><div><span class="eyebrow">在你的电脑上开始</span><h2>装入专业包，放入自己的资料。</h2></div><p>检查智能体职责与可用技能，再启用任务或日程。跑通的方法可以继续复用。</p></div><div class="start-links"><a href={href('/desktop/')}><strong>桌面端</strong><span>项目、本体与智能体放在一起 ↗</span></a><a href={href('/packs/')}><strong>本体市场</strong><span>查看起步包里的内容 ↗</span></a><a href={href('/egress/')}><strong>资料与出网</strong><span>本机保存，出网内容逐条说明 ↗</span></a></div></section>

  <section class="wrap enterprise-entry"><div><span class="eyebrow">IAI 企业版 · 私有化交付</span><h2>接上真实系统，让多人一起开展工作。</h2><p>工厂接入、权限审批与现场执行，按项目实施。</p></div><a class="btn" href={href('/enterprise/')}>了解企业版 ↗</a></section>

  <section class="sec"><div class="wrap faq"><h2>开始前，你可能想问</h2><div>
    <details open><summary>专业包里有什么？</summary><p>这里的专业包就是本体包，内置的称为起步包。它包含领域中的对象与规则、示例资料和智能体配置。装入后，你可以检查、调整，再加入自己的资料开展任务。</p></details>
    <details><summary>智能体具体能做什么？</summary><p>按配置好的职责，使用已授权的技能查询、比较资料，起草成果或执行任务。七个项目示例展示了各自的输入、分工与成果，具体执行范围取决于可用技能。</p></details>
    <details><summary>装上工厂包就能操作设备吗？</summary><p>起步包先提供设备、工序与规程的示例结构。真实设备需要适配接口、配置权限并完成现场验收，不能仅靠安装包直接控制。</p></details>
    <details><summary>每个文件夹都是一个专业包吗？</summary><p>专业包提供可复用的领域结构，文件夹保存项目资料。七个文件夹展示不同任务如何开展，可以用来理解工作方式，再按需配置本体与智能体。</p></details>
  </div></div></section>
  <div class="final"><h2>你的目标，就是开工的起点。</h2><div class="cta"><a class="btn btn-primary btn-lg" href={href('/download/')}>{cta.label}</a><a class="btn btn-lg" href={href('/packs/')}>选择起步包</a></div></div>
</main>
<style>
.domain-hero h1{margin-top:22px}.domain-hero .lede{max-width:820px}.domain-hero{padding-bottom:64px}.domain-section{padding:16px 32px 64px;scroll-margin-top:100px}.section-intro{display:flex;justify-content:space-between;align-items:end;gap:48px;margin-bottom:28px}.section-intro>p{max-width:370px;font-size:15px;color:var(--muted);line-height:1.8}.eyebrow{font-size:12px;font-weight:600;letter-spacing:.06em;color:var(--primary)}h2{font-size:clamp(26px,3vw,38px);line-height:1.4;letter-spacing:-.03em;margin:10px 0 0}.domain-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.domain-card{border:1px solid var(--line);border-radius:14px;padding:28px;background:var(--panel);display:flex;flex-direction:column}.domain-card-top{display:flex;justify-content:space-between;align-items:start}.domain-number{font-size:13px;color:var(--faint)}.domain-card h3{font-size:27px;margin:12px 0}.domain-sub{font-size:14px;color:var(--muted);margin:0;line-height:1.8}.domain-roles{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:24px 0}.domain-roles span{padding:10px;border:1px solid var(--line);border-radius:6px;background:var(--bg-2);text-align:center;font-size:13px;color:var(--ink-soft)}.domain-body{font-size:14px;line-height:1.9;color:var(--muted);margin:0 0 24px}.domain-link{margin-top:auto;padding-top:16px;border-top:1px solid var(--line);font-size:13px;color:var(--primary);display:flex;justify-content:space-between}.scope-note{font-size:12px;line-height:1.8;color:var(--muted);margin-top:16px}.system-band{background:var(--bg-2);padding:56px 0}.work-chain{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));list-style:none;padding:0;margin:32px 0}.work-chain li{padding:0 24px;border-left:1px solid var(--line-strong)}.work-chain li:first-child{padding-left:0;border-left:0}.work-chain li>span{font-size:12px;color:var(--primary)}.work-chain h3{font-size:20px;margin:16px 0 12px}.work-chain p{font-size:13px;color:var(--muted);line-height:1.9}.system-foundation{border-top:1px solid var(--line-strong);padding-top:22px;display:flex;gap:16px;font-size:14px;line-height:1.8}.system-foundation span{color:var(--muted)}.decision-preview{display:grid;grid-template-columns:1.2fr 1fr;gap:64px;padding-top:40px;padding-bottom:72px;align-items:center}.decision-preview h2{font-size:30px}.decision-preview>div>p{font-size:15px;color:var(--muted);line-height:1.8;margin:18px 0}.decision-slip{padding:28px;border:1px solid var(--line);border-radius:12px;background:var(--bg-2)}.slip-top{display:flex;justify-content:space-between;gap:12px}.decision-slip dl{margin:20px 0 0}.decision-slip dl>div{display:flex;justify-content:space-between;gap:12px;padding:13px 0;border-bottom:1px solid var(--line);font-size:14px}.decision-slip dt{color:var(--muted)}.decision-slip dd{margin:0}.missing{color:var(--warn-fg)}.decision-slip>p{font-size:12px!important;margin-bottom:0!important}.start-section{padding-top:48px;padding-bottom:64px;border-top:1px solid var(--line)}.start-links{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.start-links a{padding:20px 0;border-top:1px solid var(--line)}.start-links strong{display:block;font-size:18px;margin-bottom:10px}.start-links span{color:var(--muted);font-size:13px}.enterprise-entry{display:flex;align-items:center;justify-content:space-between;gap:32px;background:var(--bg-2);padding-top:32px;padding-bottom:32px;border-radius:12px}.enterprise-entry h2{font-size:26px}.enterprise-entry p{font-size:14px;color:var(--muted);margin-top:12px}.enterprise-entry a{flex:none}
@media(max-width:800px){.section-intro{display:block}.section-intro>p{max-width:none;margin-top:14px}.section-intro>.link{margin-top:16px}.domain-grid{grid-template-columns:1fr}.domain-section{padding-left:16px;padding-right:16px}.domain-card{padding:24px}.domain-roles{grid-template-columns:repeat(4,1fr)}.domain-roles span{padding:10px 4px}.work-chain{grid-template-columns:1fr;gap:20px}.work-chain li,.work-chain li:first-child{border-left:2px solid var(--line-strong);padding:0 0 0 20px}.work-chain h3{display:inline;margin-left:16px}.work-chain p{margin:10px 0 0}.work-chain br{display:none}.system-foundation{display:block}.system-foundation span{display:block;margin-top:8px}.decision-preview{grid-template-columns:1fr;gap:24px}.start-links{grid-template-columns:1fr;gap:0}.enterprise-entry{display:block;border-radius:0}.enterprise-entry a{margin-top:20px}}
</style>
</Base>
