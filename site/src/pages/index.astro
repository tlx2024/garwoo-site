<script is:inline>
document.querySelectorAll('[data-clone]').forEach(function (m) {
  m.innerHTML = document.getElementById('scene-' + m.dataset.clone).innerHTML;
});
// 首屏对话自动播放；数值取自 recipe-rnd 的 批次记录.csv 与 目标.md
(function () {
  var box = document.getElementById('demo-chat');
  var script = [
    ['u', '哪组配方粘度、对比率、耐擦洗三项都达标？'],
    ['t'],
    ['a', '只有 <b>F-02</b>（批次 B-1022）：粘度 99 KU、对比率 0.93、耐擦洗 5200 次<span class="cite">1</span>，都在目标内<span class="cite">2</span>。F-03 前两项达标，耐擦洗还没测<span class="cite">1</span>；F-04 粘度 112 KU，超出上限 105<span class="cite">2</span>。'],
    ['o', '<div><div class="k">表征结果 · 耐擦洗</div><b>F-03 · B-1024</b></div><span class="st warn">缺数据</span>'],
    ['u', '让记录员把 F-03 的耐擦洗排进下次实验。'],
    ['t'],
    ['a', '已委派给 <b>配方实验记录员</b>，周四 09:00 实验日提醒时列入，结果写回这里。']
  ];
  var composer = '<div class="composer">在项目里提问，或交给智能体去办<span class="go">↑</span></div>';
  function el(step) {
    var d = document.createElement('div');
    if (step[0] === 'u') { d.className = 'bub-u fade-in'; d.textContent = step[1]; }
    if (step[0] === 'a') { d.className = 'bub-a fade-in'; d.innerHTML = step[1]; }
    if (step[0] === 'o') { d.className = 'objrow fade-in'; d.innerHTML = step[1]; }
    if (step[0] === 't') { d.className = 'bub-a'; d.innerHTML = '<span class="typing"><i></i><i></i><i></i></span>'; }
    return d;
  }
  function render(n) {
    box.innerHTML = '';
    script.slice(0, n).forEach(function (s, i) { if (s[0] !== 't' || i === n - 1) box.appendChild(el(s)); });
    box.insertAdjacentHTML('beforeend', composer);
  }
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) { render(script.length); return; }
  var i = 0;
  (function tick() {
    i++; render(i);
    if (i >= script.length) { i = 0; setTimeout(tick, 6000); return; }
    setTimeout(tick, script[i - 1][0] === 't' ? 1100 : 1500);
  })();
})();
</script>
