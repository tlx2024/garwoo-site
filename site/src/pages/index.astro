---
import Base from '../layouts/Base.astro';
import HomeStory from '../components/HomeStory.astro';
import { ENDPOINTS } from '../lib/target';
import { href } from '../lib/url';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: '格物 Garwoo',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Windows 10, Windows 11',
  description: '以本体组织领域知识、智能体和工作流程，让目标落实到行动。',
  url: ENDPOINTS.site + '/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY', description: '客户端免费，官方 AI 按积分计费' },
};
---
<Base og="og-home" jsonLd={jsonLd} description="跟随一项任务，从设定目标到记录结果。" page="home">
  <script define:vars={{ examplesPage: href('/how/') }}>
    function forwardExampleLink() {
      if (/^#examples$|^#example-[a-z0-9-]+$/.test(location.hash)) {
        const link = new URL(examplesPage, location.origin);
        if (document.documentElement.lang === 'zh-CN') {
          link.pathname = link.pathname.replace(/\/how\/$/, '/zh/how/');
        }
        link.search = location.search;
        link.hash = location.hash;
        location.replace(link);
      }
    }
    forwardExampleLink();
    addEventListener('hashchange', forwardExampleLink);
  </script>
  <main id="main">
    <HomeStory />
  </main>
</Base>
