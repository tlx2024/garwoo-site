---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
---
<Base title="关于" description="格物名字的由来、吉祥物嘎呜，以及格物与 IAI 的关系。" page="about">
<style is:global>
.about{display:grid;grid-template-columns:.8fr 1.2fr;gap:64px;padding-top:96px;align-items:start}
.about h2{font-size:clamp(26px,3.2vw,36px)}
.about .tx p{margin-top:16px;font-size:17px;color:var(--ink-soft);line-height:1.9}
.about .tx p:first-child{margin-top:0}
.about .tx b{color:var(--ink)}
.rel2{display:grid;grid-template-columns:1fr auto 1fr;gap:16px;align-items:stretch}
.rel2 .mid{display:grid;place-items:center;text-align:center;font-size:13px;color:var(--muted);max-width:120px}
@media (max-width:900px){.about{grid-template-columns:1fr;gap:20px;padding-top:72px}.rel2{grid-template-columns:1fr}.rel2 .mid{max-width:none}}
</style>
<main>
  <div class="wrap hero center" style="padding-bottom:24px">
    <img class="mascot" style="width:96px;height:96px;margin:0 auto 20px" aria-hidden="true" src={href('/brand/mascot.webp')} alt="" width="512" height="512" />
    <h1>关于格物</h1>
  </div>
  <div class="wrap">
    
    <section class="about reveal">
      <h2>名字的由来</h2>
      <div class="tx">
        <p>格物取自「格物致知」：先把事物的结构弄清楚，再谈知道。对应到软件里，就是本体：这一行有哪些对象，它们怎么关联，要守哪些规矩。</p>
        <p>英文名 <b>Garwoo</b> 是「嘎呜」的拟声。</p>
      </div>
    </section>
    <section class="about reveal">
      <h2>嘎呜</h2>
      <div class="tx">
        <p>吉祥物是一只圆身、两只小角的小怪兽，张嘴就是一声「嘎呜」，意思是开工。官网上点它才会出声，产品里的提示音默认关闭。</p>
      </div>
    </section>
    <section class="about reveal">
      <h2>和 IAI 的关系</h2>
      <div class="tx">
        <p>格物和 IAI 用同一套本体和内核。一个人、一个项目文件夹用<b>格物</b>；一座工厂、多人协作、接入设备和系统用 <b>IAI</b>，私有化交付。</p>
        <div class="rel2" style="margin-top:24px">
          <a class="card hover" href={href('/desktop/')}><h3>格物</h3><p>个人版。Windows 桌面端，邀请内测。</p></a>
          <div class="mid">同一套本体与内核</div>
          <a class="card hover" href={href('/enterprise/')}><h3>IAI</h3><p>企业版。私有化交付，接入设备与系统。</p></a>
        </div>
      </div>
    </section>
    <section class="about reveal">
      <h2>运营与联系</h2>
      <div class="tx">
        <p>运营主体与联系方式在备案完成后公布。企业版咨询请通过<a class="link" style="display:inline" href={href('/enterprise/#contact')}>预约演示</a>留言。</p>
      </div>
    </section>
  </div>
  <div class="final">
    <img class="mascot" src={href('/brand/mascot.webp')} alt="" width="512" height="512" />
    <h2>格物致知，嘎呜开工。</h2>
    <div class="cta"><a class="btn btn-primary btn-lg" href={href('/download/')}>申请内测</a><a class="btn btn-lg" href={href('/how/')}>看工作方式</a></div>
  </div>
</main>
</Base>
