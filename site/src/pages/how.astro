---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
import DecisionStory from '../components/DecisionStory.astro';
import { windowsCta } from '../data/status';
const cta = await windowsCta();
---
<Base title="工作方式" description="从目标与专业包开始，组织知识、配置智能体，把决策交给具体任务，再将结果带回项目。" page="how">
<main>
  <div class="wrap hero">
    <span class="tag blue">工作方式</span>
    <h1>从一个目标<br><span class="p">到一套能开展工作的体系</span></h1>
    <p class="lede">用专业包确定领域结构，加入自己的资料，配置智能体分工。<br>每次任务围绕目标展开，结果再回到项目里。</p>
  </div>
  <section class="wrap setup">
    <div class="sec-head"><h2>先搭起你的领域，再开展具体任务。</h2></div>
    <div class="grid g3">
      <article class="card"><span class="setup-n">01</span><h3>明确目标，选专业包</h3><p>你要经营公司、开展研发，还是管理设备？选择合适的起步包，检查领域对象与规则。</p></article>
      <article class="card"><span class="setup-n">02</span><h3>加入资料，安排分工</h3><p>把记录、规范和数据放进项目。检查每个智能体的职责、可用资料与技能，再启用。</p></article>
      <article class="card"><span class="setup-n">03</span><h3>开展任务，带回结果</h3><p>让智能体按职责开展工作。确认需要你判断的事项，记录任务结果，供下一次使用。</p></article>
    </div>
  </section>
  <DecisionStory />
  <div class="wrap"><a class="link" href={href('/#examples')}>看看另外六种任务怎么开展 ↗</a></div>
  <section class="wrap working-notes">
    <div><h2>这次查清的，下次接着用。</h2><p>资料可整理成有出处的 Wiki，已确认的方法可以复用。新问题暴露出的缺口，由 AI 提议，你决定是否采纳。</p></div>
    <div><h3>资料与本体留在本机</h3><p>使用官方 AI、云端识别或聊天通道时，按出网清单说明发送内容。</p><a class="link" href={href('/egress/')}>查看出网清单 ↗</a></div>
  </section>
  <div class="final">
    <h2>从你眼前的一件事开始。</h2>
    <div class="cta"><a class="btn btn-primary btn-lg" href={href('/download/')}>{cta.label}</a><a class="btn btn-lg" href={href('/packs/')}>看看起步包</a></div>
  </div>
</main>
<style>
.hero{padding-bottom:48px}.hero h1{margin-top:22px}.hero .lede{max-width:800px}.setup{padding-top:32px;padding-bottom:64px}.setup-n{color:var(--primary);font-size:13px;font-weight:600}.setup h3{margin:16px 0 12px}.working-notes{display:grid;grid-template-columns:1.2fr 1fr;gap:80px;padding-top:40px;padding-bottom:64px;border-top:1px solid var(--line)}.working-notes h2{font-size:28px;margin:0 0 16px}.working-notes h3{font-size:18px;margin:0 0 16px}.working-notes p{font-size:16px;line-height:1.8;color:var(--muted)}.working-notes a{margin-top:16px}@media(max-width:760px){.working-notes{grid-template-columns:1fr;gap:32px}.setup{padding-bottom:40px}}
</style>
</Base>
