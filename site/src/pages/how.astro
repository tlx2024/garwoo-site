---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
import DecisionStory from '../components/DecisionStory.astro';
import ProjectExplorer from '../components/ProjectExplorer.astro';
import { windowsCta } from '../data/status';
const cta = await windowsCta();
---
<Base title="工作方式" description="从目标与专业包开始，组织知识、配置智能体，把决策交给具体任务，再将结果带回项目。" page="how">
<main>
  <div class="wrap hero">
    <span class="tag blue">工作方式</span>
    <h1>从一个目标<br><span class="p">到一套能开展工作的体系</span></h1>
    <p class="lede">用专业包确定领域结构，加入自己的资料，配置智能体分工。<br>每次任务围绕目标展开，结果再回到项目里。</p>
  </div>
  <section class="wrap setup">
    <div class="sec-head"><h2>先搭起你的领域，再开展具体任务。</h2></div>
    <div class="grid g3">
      <article class="card"><span class="setup-n">01</span><h3>明确目标，选专业包</h3><p>你要经营公司、开展研发，还是管理设备？选择合适的起步包，检查领域对象与规则。</p></article>
      <article class="card"><span class="setup-n">02</span><h3>加入资料，安排分工</h3><p>把记录、规范和数据放进项目。检查每个智能体的职责、可用资料与技能，再启用。</p></article>
      <article class="card"><span class="setup-n">03</span><h3>开展任务，带回结果</h3><p>让智能体按职责开展工作。确认需要你判断的事项，记录任务结果，供下一次使用。</p></article>
    </div>
  </section>
  <DecisionStory />
  <ProjectExplorer />
  <section class="wrap duties" id="boundaries">
    <div class="sec-head"><span class="tag blue">分工与边界</span><h2>智能体做哪些，哪些要等你定。</h2><p class="sub">每个智能体有明确的职责、可用资料和技能。边界写在前面，用起来才放心。</p></div>
    <div class="grid g3">
      <article class="card"><h3>直接做</h3><ul><li>按职责读取项目里的资料</li><li>对照规范与目标，核对记录</li><li>整理成带出处的草稿与清单</li><li>汇总待办，列出待确认事项</li></ul></article>
      <article class="card"><h3>先等你确认</h3><ul><li>会改动文件或对象的操作</li><li>AI 起草的本体条目，逐条采纳后才生效</li><li>需要判断的事项，例如缺测、冲突和日期</li></ul></article>
      <article class="card"><h3>不做</h3><ul><li>没查到的内容不写成事实，也不把缺测写成达标</li><li>不替你发送、提交或批准</li><li>出网内容以清单为准，不在清单之外发送</li></ul></article>
    </div>
  </section>
  <section class="wrap contrast" id="before-after">
    <div class="sec-head"><span class="tag blue">一次任务的对照</span><h2>同一件事，做法有什么不同。</h2></div>
    <div class="table-scroll">
      <table class="ba">
        <thead><tr><th scope="col">事情</th><th scope="col">手工做</th><th scope="col">在格物项目里</th></tr></thead>
        <tbody>
          <tr><th scope="row">写周报</th><td>翻任务表和会议纪要，自己对日期</td><td>按周报要求整理进展，注明出处，冲突和未确认事项单列</td></tr>
          <tr><th scope="row">检查实验数据</th><td>逐批比对记录与目标</td><td>把配方与批次对应起来，缺测指标单独列出，由研发人员定下一轮</td></tr>
          <tr><th scope="row">审查专利参数</th><td>在方案和规范之间来回翻页</td><td>逐条对照参数与规范，列出一致、冲突和缺少依据的内容，审阅人定稿</td></tr>
          <tr><th scope="row">安排泵站检查</th><td>查维护记录和巡检表</td><td>结合保养周期汇总到期项目与待复查异常，站长安排派工</td></tr>
        </tbody>
      </table>
    </div>
    <p class="example-foot">示例资料是合成的，说明任务的开展方式，不是实时运行结果。</p>
  </section>
  <section class="wrap working-notes">
    <div><h2>这次查清的，下次接着用。</h2><p>资料可整理成有出处的 Wiki，已确认的方法可以复用。新问题暴露出的缺口，由 AI 提议，你决定是否采纳。</p></div>
    <div><h3>资料与本体留在本机</h3><p>使用官方 AI、云端识别或聊天通道时，按出网清单说明发送内容。</p><a class="link" href={href('/egress/')}>查看出网清单 ↗</a></div>
  </section>
  <div class="final">
    <h2>从你眼前的一件事开始。</h2>
    <div class="cta"><a class="btn btn-primary btn-lg" href={href('/download/')}>{cta.label}</a><a class="btn btn-lg" href={href('/packs/')}>看看起步包</a></div>
  </div>
</main>
<style>
.duties,.contrast{padding-top:56px;padding-bottom:16px}.duties .sec-head,.contrast .sec-head{margin-bottom:28px}.duties .sec-head h2,.contrast .sec-head h2{font-size:clamp(26px,3vw,36px);margin-top:12px}.duties .card ul{margin:12px 0 0;padding-left:18px;color:var(--muted);font-size:14px;line-height:1.9}.ba{width:100%;border-collapse:collapse;font-size:14px;line-height:1.7}.ba th,.ba td{text-align:left;padding:14px 16px;border-bottom:1px solid var(--line);vertical-align:top}.ba thead th{color:var(--muted);font-size:12px;font-weight:600}.ba tbody th{font-weight:600;white-space:nowrap}.ba td:nth-child(2){color:var(--muted)}.ba td:last-child{color:var(--ink)}.example-foot{margin-top:14px;font-size:12px;color:var(--muted)}@media(max-width:760px){.duties .grid.g3{grid-template-columns:1fr}.ba{min-width:560px}}
.hero{padding-bottom:48px}.hero h1{margin-top:22px}.hero .lede{max-width:800px}.setup{padding-top:32px;padding-bottom:64px}.setup-n{color:var(--primary);font-size:13px;font-weight:600}.setup h3{margin:16px 0 12px}.working-notes{display:grid;grid-template-columns:1.2fr 1fr;gap:80px;padding-top:40px;padding-bottom:64px;border-top:1px solid var(--line)}.working-notes h2{font-size:28px;margin:0 0 16px}.working-notes h3{font-size:18px;margin:0 0 16px}.working-notes p{font-size:16px;line-height:1.8;color:var(--muted)}.working-notes a{margin-top:16px}@media(max-width:760px){.working-notes{grid-template-columns:1fr;gap:32px}.setup{padding-bottom:40px}}
</style>
</Base>
