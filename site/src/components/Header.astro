---
import Icon from './Icon.astro';
import { href } from '../lib/url';
import { accountHref } from '../lib/target';
import { windowsCta } from '../data/status';
import { getLocale, t, type Locale } from '../lib/i18n';

interface Props {
  page?: string;
  locale?: Locale;
}
const { page = '', locale = getLocale(Astro.url) } = Astro.props;
const copy = t(locale);
const cta = await windowsCta();
const cur = (p: string) => (page === p ? 'page' : undefined);
const products = [
  { icon: 'desktop', label: copy.desktop, to: '/desktop/' },
  { icon: 'phone', label: copy.mobile, to: '/mobile/' },
  { icon: 'wechat', label: copy.wechat, to: '/mobile/#weapp' },
  { icon: 'grid', label: copy.packs, to: '/packs/' },
];
const links = [
  { page: 'enterprise', label: copy.enterprise, to: '/enterprise/' },
  { page: 'pricing', label: copy.pricing, to: '/pricing/' },
  { page: 'packs', label: copy.packs, to: '/packs/' },
  { page: 'how', label: copy.how, to: '/how/' },
  { page: 'docs', label: copy.docs, to: '/docs/' },
];
---
<header class="site-header" id="hdr">
  <div class="wrap nav">
    <a class="logo" href={href('/')} aria-label="格物首页">
      <img class="for-light" src={href('/brand/logo-light.webp')} alt="格物 Garwoo" />
      <img class="for-dark" src={href('/brand/logo-dark.webp')} alt="格物 Garwoo" />
    </a>
    <ul class="menu" id="site-menu">
      <li class="has-mega">
        <button aria-expanded="false" aria-controls="product-links">{copy.products}<svg class="caret" viewBox="0 0 10 10"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></button>
        <div class="mega" id="product-links">
          {products.map((p) => (
            <a href={href(p.to)}><span class="mi"><Icon name={p.icon} /></span><b>{p.label}</b></a>
          ))}
        </div>
      </li>
      {links.map((l) => (
        <li><a href={href(l.to)} aria-current={cur(l.page)}>{l.label}</a></li>
      ))}
    </ul>
    <div class="right">
      <a class="lang-switch" href={href('/')} data-language-switch={locale === 'en' ? 'zh' : 'en'} aria-label={copy.switchTo}>{copy.switchTo}</a>
      <button class="icon-btn" id="theme" aria-label={locale === 'en' ? 'Toggle theme' : '切换明暗'}>
        <span class="for-light"><Icon name="sun" size={18} /></span>
        <span class="for-dark"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg></span>
      </button>
      <a class="btn btn-sm" href={accountHref('account')}>{copy.account}</a>
      <a class="btn btn-primary btn-sm" href={href('/download/')}>{locale === 'en' ? copy.learnBeta : cta.label}</a>
      <button class="icon-btn burger" id="burger" aria-label={copy.menu} aria-expanded="false" aria-controls="site-menu"><Icon name="menu" size={18} /></button>
    </div>
  </div>
</header>
<style>
  #product-links[hidden] { display: none; }
  @media (min-width: 961px) {
    .has-mega.open::after { content: ''; position: absolute; top: 100%; left: 0; right: 0; height: 8px; }
  }
  @media (max-width: 960px) {
    #site-menu { max-height: calc(100dvh - 100px); overflow-y: auto; }
  }
  @media (max-width: 480px) {
    .nav { gap: 12px; }
    .logo img { height: auto; max-width: min(159px, 27vw); }
  }
</style>
