---
// 嘎呜头像：浅色主题用 head-light，暗色主题用 head-dark，由 site.css 的 .for-light / .for-dark 切换。
import { href } from '../lib/url';

interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---
<img class="for-light" src={href('/brand/head-light.webp')} width={size} height={size} alt="" />
<img class="for-dark" src={href('/brand/head-dark.webp')} width={size} height={size} alt="" />
