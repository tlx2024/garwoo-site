---
import '../styles/home-story.css';
import { homeCases } from '../data/home-cases';
import { PACKS } from '../data/packs';
import { PROJECT_STORIES } from '../data/project-stories';
import Icon from './Icon.astro';
import { windowsCta } from '../data/status';
import { href } from '../lib/url';

const { label: downloadLabel } = await windowsCta();
const art = (file: string) => href(`/home/${file}`);
const stages = [
  ['domains', '选择领域'],
  ['goal', '设定目标'],
  ['organize', '整理资料'],
  ['review', '核对结果'],
  ['finish', '完成闭环'],
] as const;

const pillars = [
  ['cube', '本体', '先把这一行的结构弄清楚：有哪些对象，怎么关联，守什么规矩。起步包给出现成的，也可以让 AI 起草，逐条采纳。', '/packs/', '看起步包'],
  ['library', '资料与出处', '把记录、规范和数据放进项目。回答带出处，没查到就说没查到。', '/docs/quickstart/', '建第一个项目'],
  ['bot', '智能体与日程', '按职责分工。会改动文件或对象的操作，先等你确认。', '/how/', '看工作方式'],
  ['lock', '资料留在本机', '知识库、原件和本体在你的电脑上。哪些内容会发出去，有逐条清单。', '/egress/', '查看出网清单'],
] as const;
const faqBrief = [
  ['格物收费吗？', '客户端免费。用官方 AI 需要账号与积分，价格见价格页。页面上的金额是示例，注册与购买尚未开放。'],
  ['不买会员还能用吗？', '能。本机的浏览、编辑、检索、备份和导出都不依赖会员，也可以接自己的模型。'],
  ['资料保存在什么地方？', '在你的电脑上。云端不存本地知识库、原文档和本体结构。'],
  ['能接入产线和业务系统吗？', '个人版不接。接入 MES、SCADA、ERP，以及权限、审批、审计，通过企业版私有化交付。'],
] as const;

const chapters = [
  { id: 'goal', label: stages[1][1], title: 'goal', picture: 'cover' },
  { id: 'organize', label: stages[2][1], title: 'evidence', picture: 'evidenceArt' },
  { id: 'review', label: stages[3][1], title: 'review', picture: 'reviewArt' },
] as const;
---

<div class="home-story">
  <section class="story-hero wrap" aria-labelledby="headline">
    <div class="hero-text">
      <h1 id="headline">格物 <span>帮你构建自己专业领域</span></h1>
      <p class="hero-lede">用专业包搭起领域结构，把资料放进项目，让智能体按分工开展任务。结果带着出处回到项目里，下一次接着用。</p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href="#domains">选择领域</a>
        <a class="btn btn-lg" href="#goal">看案例</a>
      </div>
      <ul class="hero-facts" aria-label="格物的做法">
        <li>资料留在你的电脑上</li>
        <li>回答带出处</li>
        <li>改动先等你确认</li>
        <li>可接自己的模型</li>
      </ul>
    </div>
    <figure class="hero-art" role="img" aria-label="嘎呜拉着项目资料夹出发">
      <canvas class="hero-cord" aria-hidden="true"></canvas>
      <img class="hero-character" src={art('guide-brand-hero.webp?v=2')} width="768" height="768" alt="" fetchpriority="high" />
      <img class="hero-folder" src={art('guide-project-folder.webp')} width="280" height="280" alt="" />
    </figure>
  </section>

  <div class="story-flow">
    <nav class="flow-nav" aria-label="任务流程">
      <ol class="wrap stage-rail">
        {stages.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      </ol>
    </nav>

    <section class="choice-section wrap" id="domains" aria-labelledby="domains-heading">
      <h2 id="domains-heading">你想先做哪件事？</h2>
      <p class="section-sub">三个领域各有一个完整任务。选一个，跟着嘎呜从目标走到回填。</p>
      <fieldset class="choices">
        <legend class="sr-only">选择一个领域查看完整任务</legend>
        {homeCases.map((item) => (
          <label class="choice">
            <input class="sr-only" type="radio" name="domain" id={`field-${item.key}`}
              checked={item.key === 'lab'} data-record={item.record}
              data-pending={item.checks.find((row) => row[3] === 'warn')?.[2]} />
            <span class="choice-art">
              <img src={art(`domain-${item.key}.webp`)} width="320" height="320" alt="" loading="lazy" decoding="async" />
            </span>
            <span class="choice-name">{item.domain}</span>
          </label>
        ))}
      </fieldset>
      <div class="case-summary" id="workflow" aria-live="polite">
        {homeCases.map((item) => (
          <div class="task-lead" data-case={item.key}>
            <div>
              <div class="chapter-heading">
                <a class="pack-link" href={href(`/packs/${item.packSlug}/`)}>{item.pack}</a>
                <span class="case-number">{item.id}</span>
              </div>
              <h3>{item.question}</h3>
            </div>
            <a class="plain-link" href="#goal">查看任务</a>
          </div>
        ))}
      </div>
    </section>

    {chapters.map((chapter) => (
      <section class="chapter wrap" id={chapter.id} aria-label={chapter.label}>
        {homeCases.map((item) => (
          <article class="chapter-variant" data-case={item.key}>
            <div class="chapter-content">
              <div class="chapter-copy">
                <div class="chapter-heading"><span>{chapter.label}</span><span class="case-number">{item.id}</span></div>
                <h2>{item[chapter.title]}</h2>
              </div>
              <div class="chapter-detail">
                {chapter.id === 'goal' && (
                  <dl class="metrics">
                    {item.criteria.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
                  </dl>
                )}
                {chapter.id === 'organize' && (
                  <>
                    <ol class="trace-chain" aria-label="资料关联顺序">
                      {item.chain.map((label) => <li>{label}</li>)}
                    </ol>
                    <ul class="records">
                      {item.files.map(([file, use]) => <li><strong>{file}</strong><span>{use}</span></li>)}
                    </ul>
                  </>
                )}
                {chapter.id === 'review' && (
                  <>
                    <table class="review-table">
                      <caption class="sr-only">示例结果核对表</caption>
                      <thead><tr><th scope="col">检查项</th><th scope="col">现有依据</th><th scope="col">状态</th></tr></thead>
                      <tbody>
                        {item.checks.map(([label, value, status, tone]) => (
                          <tr><th scope="row">{label}</th><td>{value}</td><td class={tone}>{status}</td></tr>
                        ))}
                      </tbody>
                    </table>
                    <div class="handoff"><strong>{item.by}</strong><span>{item.reviewSource}</span></div>
                  </>
                )}
              </div>
            </div>
            <figure class="chapter-picture">
              <img src={art(item[chapter.picture][0])} alt={item[chapter.picture][1]}
                width="960" height="640" loading="lazy" decoding="async" />
              {chapter.id === 'goal' && <figcaption>{item.goalSource}</figcaption>}
            </figure>
          </article>
        ))}
      </section>
    ))}

    <section class="chapter finish" id="finish" aria-label="完成闭环">
      <div class="wrap">
        {homeCases.map((item) => (
          <article class="chapter-variant" data-case={item.key}>
            <div class="chapter-copy">
              <div class="chapter-heading"><span>完成闭环</span><span class="case-number">{item.id}</span></div>
              <h2>{item.finish}</h2>
            </div>
            <ol class="return-flow">
              {item.steps.map(([label, title]) => <li><span class="label">{label}</span><h3>{title}</h3></li>)}
            </ol>
            <p class="saved">{item.saved}</p>
            <div class="next-round">
              <strong>下一轮</strong><p>{item.reuse}</p><a class="plain-link" href="#goal">回到目标</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <div class="site-tail">
    <section class="wrap start" id="arrival" aria-labelledby="start-heading">
      <div>
        <h2 id="start-heading">开始自己的任务</h2>
        <div class="actions">
          <a class="btn btn-primary btn-lg" href={href('/download/')}>{downloadLabel}</a>
          <a class="btn btn-lg" href={href('/packs/')}>本体市场</a>
        </div>
        <nav class="start-links" aria-label="了解格物">
          <a href={href('/desktop/')}>桌面端</a>
          <a href={href('/egress/')}>资料与出网</a>
          <a href={href('/enterprise/')}>企业版</a>
          <a href={href('/docs/faq/')}>常见问题</a>
        </nav>
      </div>
      <figure class="footer-dock" role="img" aria-label="嘎呜放下资料夹">
        <img class="dock-folder dock-art" src={art('guide-project-folder.webp')} width="280" height="280" alt="" />
        <img class="dock-guide dock-art" src={art('guide-brand-docked.webp?v=2')} width="768" height="768" alt="" loading="lazy" />
      </figure>
    </section>
    <div class="wrap story-return"><a class="plain-link" href="#top" data-story-replay>回到顶部重看一遍</a></div>

    <section class="wrap explore" id="inside" aria-labelledby="inside-heading">
      <header class="explore-head"><span class="eyebrow">打开一个项目</span><h2 id="inside-heading">一个项目里有什么</h2></header>
      <div class="pillars">
        {pillars.map(([icon, title, text, to, label]) => (
          <article class="card pillar">
            <span class="ic blue"><Icon name={icon} size={18} /></span>
            <h3>{title}</h3>
            <p>{text}</p>
            <a class="link" href={href(to)}>{label}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="wrap explore" id="starter-packs" aria-labelledby="packs-heading">
      <header class="explore-head"><span class="eyebrow">起步包</span><h2 id="packs-heading">先装一个领域，再放自己的资料</h2>
        <p>起步包提供这一行的对象、出处文章、能力问题和智能体。装好以后，按自己的项目增删。</p></header>
      <div class="pack-row">
        {PACKS.map((pack) => (
          <a class="card hover pack-card" href={href(`/packs/${pack.slug}/`)}>
            <span class="tag blue">{pack.domain}</span>
            <h3>{pack.title}</h3>
            <p>{pack.sub}</p>
            <dl><div><dt>类型</dt><dd>{pack.counts[0]}</dd></div><div><dt>出处文章</dt><dd>{pack.counts[2]}</dd></div><div><dt>智能体</dt><dd>{pack.counts[4]}</dd></div></dl>
          </a>
        ))}
      </div>
    </section>

    <section class="wrap explore" id="project-gallery" aria-labelledby="gallery-heading">
      <header class="explore-head"><span class="eyebrow">七个文件夹，七种工作</span><h2 id="gallery-heading">换一个行当，任务怎么开展</h2>
        <p>示例资料是合成的，说明任务的开展方式，不是实时运行结果。</p></header>
      <ul class="gallery">
        {PROJECT_STORIES.map((story) => (
          <li><a href={href(`/how/#example-${story.id}`)}>
            <strong>{story.name}</strong>
            <span class="gallery-goal">{story.goal}</span>
            <span class="gallery-role">{story.role}</span>
          </a></li>
        ))}
        <li class="gallery-more"><a href={href('/how/#examples')}><strong>全部示例</strong><span class="gallery-goal">打开一个文件夹，看资料、分工和成果</span><span class="gallery-role">前往工作方式 →</span></a></li>
      </ul>
    </section>

    <section class="wrap explore" id="brief-faq" aria-labelledby="faq-heading">
      <header class="explore-head"><span class="eyebrow">常见问题</span><h2 id="faq-heading">下载之前，先问清这几件事</h2></header>
      <div class="brief-faq">
        {faqBrief.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
      <p class="brief-more"><a class="link" href={href('/docs/faq/')}>查看全部常见问题</a></p>
    </section>
  </div>

  <canvas class="journey-cord" aria-hidden="true" hidden></canvas>
  <img class="journey-folder" src={art('guide-project-folder.webp')} width="280" height="280" alt="" aria-hidden="true" hidden />
  <canvas class="journey-guide" data-src={art('guide-brand-motion.webp')} width="320" height="320" aria-hidden="true" hidden></canvas>
  <span class="journey-note" aria-hidden="true" hidden></span>
</div>

<script>
  import '../scripts/home-story.js';
</script>
