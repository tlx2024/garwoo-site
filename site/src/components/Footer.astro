---
import { href } from '../lib/url';
import { accountHref } from '../lib/target';
import NextStep from './NextStep.astro';
import { t } from '../lib/i18n';

const isHome = Astro.url.pathname === href('/');
const copy = t('zh');
const legalLinks = [[copy.privacy, '/legal/privacy/'], [copy.terms, '/legal/terms/']];
const groups = [
  { title: copy.product, items: [[copy.desktop, '/desktop/'], [copy.mobile, '/mobile/'], [copy.wechat, '/mobile/#weapp'], [copy.packs, '/packs/']] },
  { title: copy.pricing, items: [[copy.personal, '/pricing/'], [copy.credits, '/pricing/#credits'], [copy.enterprise, '/enterprise/']] },
  { title: copy.resources, items: [[copy.docs, '/docs/'], [copy.how, '/how/'], [copy.account, '/account/'], [copy.changelog, '/changelog/'], [copy.download, '/download/']] },
  { title: copy.enterprise, items: [[copy.enterprise, '/enterprise/'], [copy.contact, '/enterprise/#contact']] },
  { title: copy.legal, items: [...legalLinks, [copy.egress, '/egress/'], [copy.about, '/about/'], [copy.brand, '/brand/']] },
];
---
<footer class="site-footer">
  <div class="wrap">
    {!isHome && <NextStep />}
    <div class="fgrid">
      <div>
        <a class="logo" href={href('/')}>
          <img class="for-light" src={href('/brand/logo-light.webp')} alt="格物 Garwoo" />
          <img class="for-dark" src={href('/brand/logo-dark.webp')} alt="格物 Garwoo" />
        </a>
        <p class="slogan">{copy.slogan}</p>
      </div>
      {groups.map((g) => (
        <div>
          <h4>{g.title}</h4>
          {g.items.map(([label, to]) => <a href={to === '/account/' ? accountHref() : href(to)}>{label}</a>)}
        </div>
      ))}
    </div>
    <div class="legal"><span>© 2026 格物 Garwoo</span><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">京ICP备2026023547号</a></div>
  </div>
</footer>
