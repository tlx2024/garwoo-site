---
const views = [
  { name: '知识维基', example: '把一份研究笔记整理成专题，保留结论、原文出处和待核对的问题。' },
  { name: '知识图谱', example: '从一个实验批次出发，沿着关联找到用过的配方、检测记录和引用资料。' },
  { name: '数据孪生', example: '把设备档案与导入的记录对应起来，查看这份数据里各台设备的状态。' },
  { name: '驾驶舱', example: '把当前任务、关心的指标和相关知识放在同一处，决定接下来要看什么。' },
];
import { href } from '../lib/url';
---
<section class="wrap companion" id="outcomes" aria-labelledby="outcomes-title">
  <header class="introduction">
    <h2 id="outcomes-title">嘎呜陪你，把想法做成看得见的成果。</h2>
    <p>做完一次实验，嘎呜可以帮你整理批次记录、找回资料出处。你核对后留下的发现，下次调整配方时还能接着用。</p>
  </header>
  <figure class="workbench">
    <img src={href('/brand/garwoo-workbench.webp')} width="1440" height="600" loading="lazy" decoding="async"
      alt="拿清单的产品经理、戴圆眼镜的知识管家和穿白大褂的研究员，正一起核对桌上的实验记录。" />
    <figcaption>
      <span>明确目标</span><span>整理依据</span><span>核对结果</span>
    </figcaption>
  </figure>
  <dl class="outcome-list">
    {views.map(({ name, example }) => (
      <div><dt>{name}</dt><dd>{example}</dd></div>
    ))}
  </dl>

</section>
<style>
  .companion { padding-block: clamp(40px, 6vw, 80px); }
  .introduction { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(24px, 5vw, 72px); }
  .workbench { margin: 24px 0 0; border-radius: 16px; background: var(--panel); border: 1px solid var(--line); overflow: hidden; }
  .workbench img { width: 100%; height: auto; display: block; }
  figcaption { display: grid; grid-template-columns: repeat(3,1fr); text-align: center; padding: 14px 0; color: var(--ink); position: relative; }
  figcaption::before { content: ''; position: absolute; top: 0; left: 0; width: 33.333%; height: 3px; background: var(--primary); opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .workbench.is-visible figcaption::before { animation: pass-notes 3.8s ease-in-out both; }
  }
  @keyframes pass-notes {
    0%,100% { opacity: 0; }
    8%,24% { transform: translateX(0); opacity: 1; }
    42%,57% { transform: translateX(100%); opacity: 1; }
    75%,94% { transform: translateX(200%); opacity: 1; }
    100% { transform: translateX(200%); }
  }
  .introduction h2 { max-width: 13em; text-wrap: balance; font-size: clamp(26px, 3vw, 40px); line-height: 1.35; }
  .introduction p, dd { color: var(--muted); line-height: 1.85; }
  .introduction p { margin-top: 18px; }
  .outcome-list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; margin: 32px 0 0; }
  .outcome-list div { border-top: 1px solid var(--line); padding-top: 16px; }
  dt { color: var(--primary); font-weight: 650; }
  dd { margin: 8px 0 0; font-size: 14px; }
  @media (max-width: 800px) { .outcome-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .introduction, .outcome-list { grid-template-columns: 1fr; } .outcome-list { gap: 16px; } }
</style>

<script>
  const scene = document.querySelector('.workbench');
  if (scene && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(entries => {
      if (entries.some(entry => entry.isIntersecting)) {
        scene.classList.add('is-visible');
        observer.disconnect();
      }
    }, { threshold: 0.4 });
    observer.observe(scene);
  }
</script>
